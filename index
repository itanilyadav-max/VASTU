  document.querySelectorAll('.tbtn[id^="t-"]').forEach(b=>b.classList.remove('act'));
  const btn=document.getElementById('t-'+t);
  if(btn) btn.classList.add('act');
  cv.style.cursor = t==='pan'?'grab': t==='rot'?'crosshair':'crosshair';
}

function resetVaastuRot(){
  S.vaastuRot=0;
  document.getElementById('rotReadout').textContent='0°';
  // also sync compass bar needle to 0
  const bar=document.getElementById('compassBar');
  S.compassAngle=0; S.compassX=0;
}

function toggleSnap(){
  S.snap=!S.snap;
  document.getElementById('t-snap').classList.toggle('act',S.snap);
}

function snapPt(x,y){
  if(!S.snap) return {x,y};
  const g=S.scale; // snap to 1ft grid
  return {x:Math.round(x/g)*g, y:Math.round(y/g)*g};
}

function zoomBy(f){
  S.scale = Math.max(4, Math.min(30, Math.round(S.scale*f)));
  document.getElementById('inScale').value = S.scale;
  document.getElementById('scaleInfo').textContent = `Scale: ${S.scale} px = 1 ft`;
}

function fitToView(){
  if(S.verts.length<3) return;
  const bb=bbox(S.verts);
  const dx=cv.width/2-(bb.x0+bb.w/2);
  const dy=cv.height/2-(bb.y0+bb.h/2);
  S.verts=S.verts.map(v=>({x:v.x+dx,y:v.y+dy}));
  if(S.holeVerts.length) S.holeVerts=S.holeVerts.map(v=>({x:v.x+dx,y:v.y+dy}));
}

// ═══════════════════════════════════════════════════════
// MOUSE
// ═══════════════════════════════════════════════════════
const VRAD=8, ERAD=7;

function mxy(e){
  const r=cv.getBoundingClientRect();
  return {x:e.clientX-r.left, y:e.clientY-r.top};
}

cv.addEventListener('mousedown', e=>{
  const {x,y}=mxy(e);
  if(S.tool==='pan'){ S.pan={on:true,sx:x,sy:y,ox:0,oy:0}; cv.style.cursor='grabbing'; return; }

  // ── Rotation drag ──
  // Activate if: tool is 'rot', OR mouse is near the rotation ring
  if(S.verts.length>2){
    const cen=centroid(S.verts);
    const bb2=bbox(S.verts);
    const ringR = Math.min(bb2.w,bb2.h)*0.52;
    const d=dst(x,y,cen.x,cen.y);
    const onRing = Math.abs(d-ringR)<14;

    if(S.tool==='rot' || onRing){
      const startAngle=Math.atan2(y-cen.y,x-cen.x)*180/Math.PI;
      S.rotDrag={on:true, startAngle, startRot:S.vaastuRot};
      cv.style.cursor='grabbing';
      return;
    }
  }

  // check vertex handles
  for(let i=0;i<S.verts.length;i++){
    if(dst(x,y,S.verts[i].x,S.verts[i].y)<VRAD+4){
      S.drag={on:true,type:'v',idx:i,ox:x,oy:y,snapVerts:S.verts.map(v=>({...v}))};
      return;
    }
  }
  // check edge midpoint handles
  const mids=edgeMid(S.verts);
  for(let i=0;i<mids.length;i++){
    if(dst(x,y,mids[i].x,mids[i].y)<ERAD+4){
      S.drag={on:true,type:'e',idx:i,ox:x,oy:y,snapVerts:S.verts.map(v=>({...v}))};
      return;
    }
  }
});

cv.addEventListener('mousemove', e=>{
  const {x,y}=mxy(e);
  document.getElementById('coordInfo').textContent=
    `${(x/S.scale).toFixed(1)} ft,  ${(y/S.scale).toFixed(1)} ft`;

  // Update compass needle based on angle from centroid
  if(S.verts.length>2){
    const cen=centroid(S.verts);
    let ang=Math.atan2(y-cen.y, x-cen.x)*180/Math.PI;
    if(ang<0) ang+=360;
    S.compassAngle=ang;
    // compass bar position: ang/360 * barWidth
    const bar=document.getElementById('compassBar');
    S.compassX=(ang/360)*bar.width;
    // find which zone
    let zoneName='—';
    for(let i=0;i<Z16.length;i++){
      const za=Z16[i][3]; let s=za-11.25,e2=za+11.25;
      if(s<0)s+=360; if(e2>=360)e2-=360;
      let hit=s>e2?(ang>=s||ang<e2):(ang>=s&&ang<e2);
      if(hit){zoneName=Z16[i][1]+' · '+Z16[i][4];break;}
    }
    document.getElementById('compassAngle').textContent=
      `${ang.toFixed(1)}°  |  ${zoneName}`;
  }

  // ── Rotation drag active ──
  if(S.rotDrag.on){
    if(S.verts.length>2){
      const cen=centroid(S.verts);
      const curAngle=Math.atan2(y-cen.y,x-cen.x)*180/Math.PI;
      let delta=curAngle-S.rotDrag.startAngle;
      let newRot=(S.rotDrag.startRot+delta)%360;
      if(newRot<0) newRot+=360;
      S.vaastuRot=newRot;
      document.getElementById('rotReadout').textContent=newRot.toFixed(1)+'°';
      // sync compass needle to current rotation
      const bar=document.getElementById('compassBar');
      S.compassAngle=newRot;
      S.compassX=(newRot/360)*bar.width;
      // update zone name in compass
      let zoneName='—';
      for(let i=0;i<Z16.length;i++){
        const za=(Z16[i][3]+newRot)%360;
        let s=za-11.25,e2=za+11.25;
        if(s<0)s+=360; if(e2>=360)e2-=360;
        // show zone under north (270° in canvas = N)
      }
      document.getElementById('compassAngle').textContent=`${newRot.toFixed(1)}°  |  Vaastu Rotation`;
    }
    cv.style.cursor='grabbing';
    return;
  }

  // PAN
  if(S.pan.on){
    const dx=x-S.pan.sx, dy=y-S.pan.sy;
    S.verts=S.verts.map((v,i)=>({x:S.drag.snapVerts?S.drag.snapVerts[i].x+dx:v.x, y:S.drag.snapVerts?S.drag.snapVerts[i].y+dy:v.y}));
    return;
  }
  if(S.tool==='pan') return;

  if(S.drag.on){
    const sp = snapPt(x,y);
    const dx=sp.x-S.drag.ox, dy=sp.y-S.drag.oy;

    if(S.drag.type==='v'){
      const nv = S.drag.snapVerts.map((v,i)=> i===S.drag.idx ? {x:v.x+dx,y:v.y+dy} : {...v});
      const c=centroid(nv);
      if(c.area>500) S.verts=nv; // prevent collapse
    }
    if(S.drag.type==='e'){
      // push both vertices of the edge perpendicularly
      const mi=S.drag.idx;
      const vi=S.verts[mi];
      const vj=S.verts[(mi+1)%S.verts.length];
      const ex=vj.x-vi.x, ey=vj.y-vi.y;
      const len=Math.sqrt(ex*ex+ey*ey)||1;
      const nx=-ey/len, ny=ex/len; // perpendicular inward
      const proj = dx*nx + dy*ny;
      const nv = S.drag.snapVerts.map((v,i)=>{
        if(i===S.drag.idx||(i===(S.drag.idx+1)%S.verts.length)){
          return {x:v.x+nx*proj, y:v.y+ny*proj};
        }
        return {...v};
      });
      const c=centroid(nv);
      if(c.area>500) S.verts=nv;
    }
    cv.style.cursor='grabbing';
    return;
  }

  // hover checks
  let hv=-1, he=-1, hz=-1, onRing=false;
  for(let i=0;i<S.verts.length;i++){
    if(dst(x,y,S.verts[i].x,S.verts[i].y)<VRAD+4){ hv=i; break; }
  }
  if(hv<0){
    const mids=edgeMid(S.verts);
    for(let i=0;i<mids.length;i++){
      if(dst(x,y,mids[i].x,mids[i].y)<ERAD+4){ he=i; break; }
    }
  }
  if(hv<0&&he<0&&S.verts.length>2){
    const cen=centroid(S.verts);
    const bb2=bbox(S.verts);
    const ringR=Math.min(bb2.w,bb2.h)*0.52;
    onRing = Math.abs(dst(x,y,cen.x,cen.y)-ringR)<14;
    hz=zoneAt(x,y,cen);
  }
  S.hovV=hv; S.hovE=he; S.hovZone=hz;
  if(S.tool==='rot') cv.style.cursor='crosshair';
  else if(hv>=0||he>=0) cv.style.cursor='grab';
  else if(onRing) cv.style.cursor='grab';
  else if(hz>=0) cv.style.cursor='pointer';
  else cv.style.cursor='crosshair';
});

cv.addEventListener('mouseup', e=>{
  if(S.pan.on){ S.pan.on=false; cv.style.cursor='grab'; return; }
  if(S.rotDrag.on){ S.rotDrag.on=false; cv.style.cursor= S.tool==='rot'?'crosshair':'crosshair'; return; }
  if(S.drag.on){
    S.drag.on=false;
    if(S.tool==='pan') cv.style.cursor='grab';
    return;
  }
  // click zone (only in sel tool)
  if(S.tool==='sel'){
    const {x,y}=mxy(e);
    if(S.verts.length>2){
      const cen=centroid(S.verts);
      const z=zoneAt(x,y,cen);
      if(z>=0){ S.selZone=z; updateZoneCard(z); }
    }
  }
});

cv.addEventListener('mouseleave', ()=>{
  S.drag.on=false; S.pan.on=false; S.rotDrag.on=false;
  S.hovV=-1; S.hovE=-1; S.hovZone=-1;
  S.compassAngle=-1; S.compassX=-1;
  document.getElementById('compassAngle').textContent='— °  |  —';
});

cv.addEventListener('wheel', e=>{
  e.preventDefault();
  const f = e.deltaY<0?1.1:0.91;
  S.scale = Math.max(4, Math.min(30, +(S.scale*f).toFixed(1)));
  document.getElementById('inScale').value = S.scale;
  document.getElementById('scaleInfo').textContent = `Scale: ${S.scale} px = 1 ft`;
},{passive:false});

// ═══════════════════════════════════════════════════════
// RENDER LOOP
// ═══════════════════════════════════════════════════════
function render(){
  S.raf=requestAnimationFrame(render);
  cx.clearRect(0,0,cv.width,cv.height);

  drawGrid();

  drawCompassBar(); // always redraw compass for live needle

  if(S.verts.length<3) return;

  const cen = centroid(S.verts);
  const bb  = bbox(S.verts);

  if(S.layers.zones)    drawZones(cen,bb);
  if(S.layers.pada)     drawPada(bb);
  drawShape(cen);
  if(S.layers.pts16)    draw16pts(cen,bb);
  if(S.layers.brahma)   drawBrahma(cen,bb);
  if(S.layers.devta)    drawDevta(cen,bb);
  if(S.layers.attr)     drawAttr(cen,bb);
  if(S.layers.rooms)    drawRooms(cen,bb);
  drawHandles();
  drawDims();
}

// ─── architect graph paper grid ───
function drawGrid(){
  const W=cv.width, H=cv.height, g=S.scale, G=g*5;
  cx.save();
  // fine grid
  cx.strokeStyle='rgba(80,130,200,.055)'; cx.lineWidth=.5;
  for(let x=0;x<W;x+=g){ cx.beginPath();cx.moveTo(x,0);cx.lineTo(x,H);cx.stroke(); }
  for(let y=0;y<H;y+=g){ cx.beginPath();cx.moveTo(0,y);cx.lineTo(W,y);cx.stroke(); }
  // major grid
  cx.strokeStyle='rgba(80,130,200,.12)'; cx.lineWidth=.8;
  for(let x=0;x<W;x+=G){ cx.beginPath();cx.moveTo(x,0);cx.lineTo(x,H);cx.stroke(); }
  for(let y=0;y<H;y+=G){ cx.beginPath();cx.moveTo(0,y);cx.lineTo(W,y);cx.stroke(); }
  // dots at intersections
  cx.fillStyle='rgba(80,130,200,.09)';
  for(let x=0;x<W;x+=G) for(let y=0;y<H;y+=G){
    cx.beginPath();cx.arc(x,y,1.2,0,Math.PI*2);cx.fill();
  }
  cx.restore();
}

// ─── zone wedges ───
function drawZones(cen,bb){
  const R=Math.max(bb.w,bb.h)*1.1;
  const rot=S.vaastuRot*Math.PI/180; // rotation in radians
  cx.save();
  cx.beginPath();
  S.verts.forEach((v,i)=>i===0?cx.moveTo(v.x,v.y):cx.lineTo(v.x,v.y));
  cx.closePath(); cx.clip();

  Z16.forEach((z,i)=>{
    const baseAngle = z[3]*Math.PI/180 + rot;
    const a0=baseAngle-11.25*Math.PI/180, a1=baseAngle+11.25*Math.PI/180;
    const sel=S.selZone===i, hov=S.hovZone===i;

    cx.beginPath();
    cx.moveTo(cen.x,cen.y);
    cx.arc(cen.x,cen.y,R,a0,a1);
    cx.closePath();

    let fill=z[7];
    if(sel)  fill=fill.replace(/[\d.]+\)$/,'0.42)');
    else if(hov) fill=fill.replace(/[\d.]+\)$/,'0.3)');
    cx.fillStyle=fill; cx.fill();

    // divider line
    cx.beginPath();
    cx.moveTo(cen.x,cen.y);
    cx.lineTo(cen.x+R*Math.cos(a0), cen.y+R*Math.sin(a0));
    cx.strokeStyle=z[8]+'44'; cx.lineWidth=.8;
    cx.setLineDash([4,4]); cx.stroke(); cx.setLineDash([]);
  });
  cx.restore();

  // direction abbreviations
  Z16.forEach(z=>{
    const r=Math.min(bb.w,bb.h)*.47;
    const ar=z[3]*Math.PI/180+rot;
    const lx=cen.x+r*Math.cos(ar), ly=cen.y+r*Math.sin(ar);
    if(!pip(lx,ly,S.verts)) return;
    cx.save();
    cx.fillStyle=z[8]; cx.font=`bold ${z[2].length>2?8:10}px Inter`;
    cx.textAlign='center'; cx.textBaseline='middle'; cx.globalAlpha=.9;
    cx.fillText(z[2],lx,ly);
    cx.restore();
  });
}

// ─── 9×9 pada grid ───
function drawPada(bb){
  cx.save();
  cx.beginPath();
  S.verts.forEach((v,i)=>i===0?cx.moveTo(v.x,v.y):cx.lineTo(v.x,v.y));
  cx.closePath(); cx.clip();
  const cw=bb.w/9, ch=bb.h/9;
  cx.strokeStyle='rgba(212,168,67,.22)'; cx.lineWidth=.65;
  for(let i=0;i<=9;i++){
    cx.beginPath();cx.moveTo(bb.x0+i*cw,bb.y0);cx.lineTo(bb.x0+i*cw,bb.y1);cx.stroke();
    cx.beginPath();cx.moveTo(bb.x0,bb.y0+i*ch);cx.lineTo(bb.x1,bb.y0+i*ch);cx.stroke();
  }
  cx.fillStyle='rgba(212,168,67,.12)'; cx.font='6.5px Inter'; cx.textAlign='center'; cx.textBaseline='middle';
  for(let r=0;r<9;r++) for(let c=0;c<9;c++){
    cx.fillText(r*9+c+1, bb.x0+(c+.5)*cw, bb.y0+(r+.5)*ch);
  }
  cx.restore();
}

// ─── floor shape outline ───
function drawShape(){
  cx.save();
  cx.beginPath();
  S.verts.forEach((v,i)=>i===0?cx.moveTo(v.x,v.y):cx.lineTo(v.x,v.y));
  cx.closePath();
  if(S.holeVerts.length){
    cx.moveTo(S.holeVerts[0].x,S.holeVerts[0].y);
    S.holeVerts.forEach((v,i)=>{ if(i>0)cx.lineTo(v.x,v.y); });
    cx.closePath();
  }
  // floor fill
  cx.fillStyle='rgba(200,185,150,.06)';
  cx.fill('evenodd');
  // outer wall thick
  cx.strokeStyle='#7a6a4a'; cx.lineWidth=3.5; cx.stroke();
  // inner double line
  cx.strokeStyle='rgba(212,168,67,.35)'; cx.lineWidth=1;
  cx.setLineDash([5,3]); cx.stroke(); cx.setLineDash([]);
  cx.restore();
}

// ─── 16 radial wall-point markers ───
function draw16pts(cen,bb){
  const R=Math.max(bb.w,bb.h)*.72;
  const rot=S.vaastuRot*Math.PI/180;
  Z16.forEach((z,i)=>{
    const ar=z[3]*Math.PI/180+rot;
    let px=cen.x, py=cen.y;
    let found=false;
    for(let r=0;r<=R;r+=2){
      const tx=cen.x+r*Math.cos(ar), ty=cen.y+r*Math.sin(ar);
      if(!pip(tx,ty,S.verts)){ px=tx;py=ty;found=true;break; }
    }
    if(!found) return;
    cx.save();
    cx.beginPath(); cx.arc(px,py,4,0,Math.PI*2);
    cx.fillStyle=z[8]; cx.fill();
    cx.strokeStyle='#0c1018'; cx.lineWidth=1.2; cx.stroke();
    const ox=12, lx=cen.x+(R+ox)*Math.cos(ar), ly=cen.y+(R+ox)*Math.sin(ar);
    if(pip(lx,ly,S.verts)) { cx.restore(); return; }
    cx.font=`bold 8px Inter`; cx.fillStyle=z[8]; cx.textAlign='center'; cx.textBaseline='middle';
    cx.fillText(z[2], lx, ly);
    cx.restore();
  });
}

// ─── brahmasthan ───
function drawBrahma(cen,bb){
  const r=Math.min(bb.w,bb.h)*.11;
  cx.save();
  const g=cx.createRadialGradient(cen.x,cen.y,0,cen.x,cen.y,r*3);
  g.addColorStop(0,'rgba(212,168,67,.38)');
  g.addColorStop(.5,'rgba(212,168,67,.1)');
  g.addColorStop(1,'rgba(212,168,67,0)');
  cx.fillStyle=g; cx.beginPath(); cx.arc(cen.x,cen.y,r*3,0,Math.PI*2); cx.fill();
  // ring
  cx.strokeStyle='rgba(212,168,67,.7)'; cx.lineWidth=1.5;
  cx.beginPath(); cx.arc(cen.x,cen.y,r,0,Math.PI*2); cx.stroke();
  // cross hairs
  cx.strokeStyle='rgba(212,168,67,.45)'; cx.lineWidth=.8; cx.setLineDash([3,3]);
  cx.beginPath();cx.moveTo(cen.x-r*1.8,cen.y);cx.lineTo(cen.x+r*1.8,cen.y);cx.stroke();
  cx.beginPath();cx.moveTo(cen.x,cen.y-r*1.8);cx.lineTo(cen.x,cen.y+r*1.8);cx.stroke();
  cx.setLineDash([]);
  // centre label
  cx.font='bold 9.5px Inter'; cx.fillStyle='rgba(212,168,67,.92)';
  cx.textAlign='center'; cx.textBaseline='middle';
  cx.fillText('ब्रह्म', cen.x, cen.y-.5);
  cx.font='7px Inter'; cx.fillStyle='rgba(212,168,67,.55)';
  cx.fillText('Brahmasthan', cen.x, cen.y+r*.55);
  cx.restore();
}

// ─── devta names ───
function drawDevta(cen,bb){
  const r=Math.min(bb.w,bb.h)*.33;
  Z16.forEach(z=>{
    const ar=z[3]*Math.PI/180;
    const lx=cen.x+r*Math.cos(ar), ly=cen.y+r*Math.sin(ar);
    if(!pip(lx,ly,S.verts)) return;
    cx.save();
    cx.font='bold 7.5px Inter'; cx.fillStyle=z[8];
    cx.textAlign='center'; cx.textBaseline='middle'; cx.globalAlpha=.92;
    cx.fillText(z[4],lx,ly);
    cx.restore();
  });
}

// ─── attribute labels ───
function drawAttr(cen,bb){
  const r=Math.min(bb.w,bb.h)*.23;
  Z16.forEach(z=>{
    const ar=z[3]*Math.PI/180;
    const lx=cen.x+r*Math.cos(ar), ly=cen.y+r*Math.sin(ar);
    if(!pip(lx,ly,S.verts)) return;
    cx.save();
    cx.font='6.5px Inter'; cx.fillStyle='rgba(230,220,210,.78)';
    cx.textAlign='center'; cx.textBaseline='middle';
    cx.fillText(z[10].split('(')[0].trim(),lx,ly);
    cx.restore();
  });
}

// ─── room recommendation chips ───
function drawRooms(cen,bb){
  const r=Math.min(bb.w,bb.h)*.55;
  Z16.forEach(z=>{
    const ar=z[3]*Math.PI/180;
    const lx=cen.x+r*Math.cos(ar), ly=cen.y+r*Math.sin(ar);
    if(!pip(lx,ly,S.verts)) return;
    const txt=z[11].split('/')[0].trim();
    cx.save();
    cx.font='7px Inter';
    const tw=cx.measureText(txt).width+9;
    // chip bg
    cx.fillStyle=z[7].replace(/[\d.]+\)$/,'0.65)');
    cx.strokeStyle=z[8]; cx.lineWidth=.9;
    cx.beginPath(); roundRect(cx,lx-tw/2,ly-8,tw,16,4); cx.fill(); cx.stroke();
    cx.fillStyle='rgba(240,235,220,.96)';
    cx.textAlign='center'; cx.textBaseline='middle';
    cx.fillText(txt,lx,ly);
    cx.restore();
  });
}

function roundRect(ctx,x,y,w,h,r){
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.arcTo(x+w,y,x+w,y+r,r);
  ctx.lineTo(x+w,y+h-r); ctx.arcTo(x+w,y+h,x+w-r,y+h,r);
  ctx.lineTo(x+r,y+h); ctx.arcTo(x,y+h,x,y+h-r,r);
  ctx.lineTo(x,y+r); ctx.arcTo(x,y,x+r,y,r); ctx.closePath();
}

// ─── vertex & edge handles ───
function drawHandles(){
  // edge midpoints
  const mids=edgeMid(S.verts);
  mids.forEach((m,i)=>{
    const hov=S.hovE===i, drag=S.drag.on&&S.drag.type==='e'&&S.drag.idx===i;
    cx.save();
    cx.beginPath();
    // diamond
    const s=drag?7:hov?6:4;
    cx.moveTo(m.x, m.y-s); cx.lineTo(m.x+s, m.y); cx.lineTo(m.x, m.y+s); cx.lineTo(m.x-s, m.y); cx.closePath();
    cx.fillStyle=drag?'#4ecdc4':hov?'#4ecdc4bb':'#2a4a50';
    cx.fill(); cx.strokeStyle='#0c1018'; cx.lineWidth=1; cx.stroke();
    cx.restore();
  });

  // corner vertices
  S.verts.forEach((v,i)=>{
    const hov=S.hovV===i, drag=S.drag.on&&S.drag.type==='v'&&S.drag.idx===i;
    cx.save();
    cx.beginPath(); cx.arc(v.x,v.y,drag?8:hov?7:5,0,Math.PI*2);
    cx.fillStyle=drag?'#d4a843':hov?'#d4a843cc':'#7a6a4a';
    cx.fill(); cx.strokeStyle='#0c1018'; cx.lineWidth=1.5; cx.stroke();
    if(hov||drag){
      cx.beginPath(); cx.arc(v.x,v.y,13,0,Math.PI*2);
      cx.strokeStyle='rgba(212,168,67,.3)'; cx.lineWidth=1; cx.stroke();
    }
    cx.restore();
  });
}

// ─── floating dimension labels ───
function drawDims(){
  if(S.verts.length<2) return;
  const vs=S.verts;
  cx.save();
  cx.font='9.5px Inter'; cx.textAlign='center'; cx.textBaseline='middle';
  for(let i=0;i<vs.length;i++){
    const j=(i+1)%vs.length;
    const d=dst(vs[i].x,vs[i].y,vs[j].x,vs[j].y);
    if(d<18) continue;
    const mx=(vs[i].x+vs[j].x)/2, my=(vs[i].y+vs[j].y)/2;
    const ft=(d/S.scale).toFixed(1);
    const ang=Math.atan2(vs[j].y-vs[i].y,vs[j].x-vs[i].x);
    const ox=-Math.sin(ang)*14, oy=Math.cos(ang)*14;
    const lx=mx+ox, ly=my+oy;
    const tw=cx.measureText(ft+' ft').width+8;
    cx.fillStyle='rgba(9,14,22,.8)';
    cx.beginPath(); roundRect(cx,lx-tw/2,ly-9,tw,18,4); cx.fill();
    cx.fillStyle='rgba(212,168,67,.92)';
    cx.fillText(ft+' ft',lx,ly);
  }
  cx.restore();
}

