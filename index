<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VaastuCAD — Interactive Floor Plan Builder</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap');
:root{
  --bg:       #0c1018;
  --bg1:      #141a24;
  --bg2:      #1b2333;
  --bd:       #2a3650;
  --gold:     #d4a843;
  --gold2:    rgba(212,168,67,0.12);
  --teal:     #4ecdc4;
  --txt:      #dde4ee;
  --muted:    #8b97aa;
  --dim:      #4a5568;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;font-family:'Inter',sans-serif;background:var(--bg);color:var(--txt)}
/* ── layout ── */
#app{display:flex;flex-direction:column;height:100vh}
#hdr{display:flex;align-items:center;justify-content:space-between;padding:8px 18px;background:var(--bg1);border-bottom:1px solid var(--bd);flex-shrink:0;z-index:20}
#body{display:flex;flex:1;overflow:hidden;min-height:0}
/* ── panels ── */
.lpanel{width:252px;flex-shrink:0;background:var(--bg2);border-right:1px solid var(--bd);overflow-y:auto;padding:12px 10px;display:flex;flex-direction:column;gap:10px}
.lpanel::-webkit-scrollbar{width:3px}
.lpanel::-webkit-scrollbar-thumb{background:var(--bd)}
.rpanel{width:238px;flex-shrink:0;background:var(--bg2);border-left:1px solid var(--bd);overflow-y:auto;display:flex;flex-direction:column}
.rpanel::-webkit-scrollbar{width:3px}
.rpanel::-webkit-scrollbar-thumb{background:var(--bd)}
/* ── canvas ── */
#carea{flex:1;position:relative;background:#090e16;overflow:hidden}
#cv{display:block;position:absolute;inset:0}
/* ── card ── */
.card{background:var(--bg1);border:1px solid var(--bd);border-radius:10px;padding:12px}
.stitle{font-size:9.5px;font-weight:700;color:var(--gold);letter-spacing:2.2px;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.stitle::after{content:'';flex:1;height:1px;background:var(--bd)}
/* ── inputs ── */
.row2{display:flex;gap:7px}
.ig{flex:1}
.ilb{display:block;font-size:10px;color:var(--muted);margin-bottom:3px}
.ifield{width:100%;background:var(--bg);border:1px solid var(--bd);border-radius:6px;color:var(--txt);padding:6px 9px;font-size:12px;font-family:'Inter',sans-serif;outline:none;transition:border .18s}
.ifield:focus{border-color:var(--gold)}
/* ── shape grid ── */
.sgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.sbtn{background:var(--bg);border:1px solid var(--bd);border-radius:7px;padding:7px 3px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;color:var(--dim);font-size:9.5px;font-weight:500;transition:all .18s}
.sbtn:hover{border-color:var(--gold);color:var(--gold);background:var(--gold2)}
.sbtn.act{border-color:var(--gold);background:var(--gold2);color:var(--gold)}
/* ── checks ── */
.chk{display:flex;align-items:flex-start;gap:8px;padding:7px 0;border-bottom:1px solid #1e2a3a;cursor:pointer;user-select:none}
.chk:last-child{border-bottom:none}
.cbox{width:15px;height:15px;flex-shrink:0;border:1.5px solid var(--bd);border-radius:4px;margin-top:2px;display:flex;align-items:center;justify-content:center;background:var(--bg);transition:all .18s}
.cbox.on{background:var(--gold);border-color:var(--gold)}
.clb{font-size:11.5px;color:var(--txt);line-height:1.35}
.csb{font-size:9.5px;color:var(--muted)}
/* ── buttons ── */
.btn1{width:100%;background:var(--gold);color:#09100f;border:none;border-radius:7px;padding:8px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;letter-spacing:.4px;transition:opacity .18s}
.btn1:hover{opacity:.88}
.btn2{width:100%;background:transparent;color:var(--muted);border:1px solid var(--bd);border-radius:7px;padding:8px;font-size:11px;font-weight:500;cursor:pointer;font-family:'Inter',sans-serif;transition:all .18s}
.btn2:hover{border-color:var(--muted);color:var(--txt)}
/* ── toolbar ── */
#tbar{position:absolute;top:10px;left:50%;transform:translateX(-50%);display:flex;gap:4px;background:var(--bg1);border:1px solid var(--bd);border-radius:8px;padding:5px 7px;z-index:10}
.tbtn{background:transparent;border:none;color:var(--muted);cursor:pointer;padding:4px 9px;border-radius:5px;font-size:10.5px;font-family:'Inter',sans-serif;display:flex;align-items:center;gap:4px;transition:all .18s}
.tbtn:hover{background:var(--bd);color:var(--txt)}
.tbtn.act{background:var(--gold2);color:var(--gold)}
#scaleInfo{position:absolute;bottom:10px;left:10px;font-size:9.5px;color:var(--dim);background:rgba(9,14,22,.82);padding:3px 8px;border-radius:4px;border:1px solid var(--bd)}
#coordInfo{position:absolute;bottom:10px;right:10px;font-size:9.5px;color:var(--dim);background:rgba(9,14,22,.82);padding:3px 8px;border-radius:4px;border:1px solid var(--bd)}
/* ── right panel ── */
#rphdr{padding:14px 16px 10px;background:var(--bg1);border-bottom:1px solid var(--bd);text-align:center}
#rphdr h3{font-family:'Playfair Display',serif;font-size:14px;color:var(--gold);margin-bottom:3px}
#rphdr p{font-size:9.5px;color:var(--muted);letter-spacing:1.5px}
#zmsg{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;padding:20px 14px;text-align:center;color:var(--dim)}
#zmsg svg{opacity:.3;margin-bottom:10px}
#zmsg p{font-size:10.5px;line-height:1.65}
#zcard{padding:14px;display:none}
.irow{display:flex;align-items:flex-start;gap:7px;margin-bottom:7px;padding:7px;background:var(--bg1);border-radius:6px;border:1px solid var(--bd)}
.irl{font-size:8.5px;color:var(--dim);letter-spacing:1.5px;text-transform:uppercase;flex-shrink:0;width:52px;padding-top:1px}
.irv{font-size:10.5px;color:var(--txt);line-height:1.4}
.dil,.xil{font-size:9.5px;color:var(--muted);padding:2px 0 2px 11px;position:relative;line-height:1.45}
.dil::before{content:'✓';position:absolute;left:0;color:#4ade80;font-size:9px}
.xil::before{content:'✗';position:absolute;left:0;color:#f87171;font-size:9px}
.dtit{font-size:9.5px;font-weight:700;display:flex;align-items:center;gap:4px;margin-bottom:4px}
/* ── logo ── */
.logo{display:flex;align-items:center;gap:9px}
.logo-text{font-family:'Playfair Display',serif;font-size:17px;color:var(--gold)}
.logo-sub{font-size:9.5px;color:var(--muted);letter-spacing:2px;text-transform:uppercase}

/* ── compass ruler bar ── */
#compassWrap{
  flex-shrink:0;
  background:var(--bg1);
  border-top:1px solid var(--bd);
  padding:0;
  position:relative;
  height:62px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  user-select:none;
}
#compassBar{
  display:block;
  width:100%;
  height:100%;
  cursor:crosshair;
}
#compassLabel{
  position:absolute;
  top:4px;
  left:10px;
  font-size:8.5px;
  font-weight:700;
  color:var(--gold);
  letter-spacing:2px;
  text-transform:uppercase;
  pointer-events:none;
}
#compassAngle{
  position:absolute;
  top:4px;
  right:10px;
  font-size:9px;
  color:var(--muted);
  pointer-events:none;
  font-variant-numeric:tabular-nums;
}
</style>
</head>
<body>
<div id="app">

<!-- ═══ HEADER ═══ -->
<header id="hdr">
  <div class="logo">
    <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
      <rect width="30" height="30" rx="5" fill="#1b2333"/>
      <polygon points="15,2 28,8.5 28,21.5 15,28 2,21.5 2,8.5" stroke="#d4a843" stroke-width="1.4" fill="none"/>
      <circle cx="15" cy="15" r="2.8" fill="#d4a843" opacity=".85"/>
      <line x1="15" y1="2" x2="15" y2="28" stroke="#d4a843" stroke-width=".5" opacity=".3"/>
      <line x1="2" y1="8.5" x2="28" y2="21.5" stroke="#d4a843" stroke-width=".5" opacity=".3"/>
      <line x1="2" y1="21.5" x2="28" y2="8.5" stroke="#d4a843" stroke-width=".5" opacity=".3"/>
    </svg>
    <div>
      <div class="logo-text">VaastuCAD</div>
      <div class="logo-sub">Floor Plan Builder</div>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:14px">
    <span style="font-size:10.5px;color:var(--muted)">16-Zone Vaastu Shastra Analysis · CAD Engine</span>
    <div style="width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 6px #4ade80aa"></div>
  </div>
</header>

<div id="body">

<!-- ═══ LEFT PANEL ═══ -->
<aside class="lpanel">

  <div class="card">
    <div class="stitle">Dimensions</div>
    <div class="row2">
      <div class="ig"><label class="ilb">Length (ft)</label><input class="ifield" type="number" id="inL" value="40" min="8" max="300"></div>
      <div class="ig"><label class="ilb">Breadth (ft)</label><input class="ifield" type="number" id="inB" value="30" min="8" max="300"></div>
    </div>
    <div style="display:flex;gap:6px;margin-top:8px">
      <div class="ig"><label class="ilb">Scale (px/ft)</label><input class="ifield" type="number" id="inScale" value="11" min="4" max="30"></div>
      <div class="ig" style="display:flex;flex-direction:column;justify-content:flex-end"><button class="btn1" onclick="applyDims()">Apply</button></div>
    </div>
  </div>

  <div class="card">
    <div class="stitle">Floor Shape</div>
    <div class="sgrid" id="sgrid"></div>
  </div>

  <div class="card">
    <div class="stitle">Vaastu Layers</div>
    <div id="layerchecks">
      <div class="chk" onclick="toggleLayer('zones')"><div class="cbox on" id="ck-zones"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#09100f" stroke-width="3.5"><polyline points="20 6 9 17 4 12"/></svg></div><div><div class="clb">16 Zones &amp; Directions</div><div class="csb">Colour-coded wedges</div></div></div>
      <div class="chk" onclick="toggleLayer('pada')"><div class="cbox" id="ck-pada"></div><div><div class="clb">Pada Grid (9 × 9)</div><div class="csb">81-square Vastu grid</div></div></div>
      <div class="chk" onclick="toggleLayer('devta')"><div class="cbox" id="ck-devta"></div><div><div class="clb">Devta Names</div><div class="csb">Sanskrit deity labels</div></div></div>
      <div class="chk" onclick="toggleLayer('attr')"><div class="cbox" id="ck-attr"></div><div><div class="clb">Characteristics</div><div class="csb">Zone energy attributes</div></div></div>
      <div class="chk" onclick="toggleLayer('rooms')"><div class="cbox" id="ck-rooms"></div><div><div class="clb">Room Recommendations</div><div class="csb">Optimal placements</div></div></div>
      <div class="chk" onclick="toggleLayer('pts16')"><div class="cbox" id="ck-pts16"></div><div><div class="clb">16 Wall Points</div><div class="csb">Radial markers on boundary</div></div></div>
      <div class="chk" onclick="toggleLayer('brahma')"><div class="cbox on" id="ck-brahma"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#09100f" stroke-width="3.5"><polyline points="20 6 9 17 4 12"/></svg></div><div><div class="clb">Brahmasthan</div><div class="csb">Centre glow &amp; pivot</div></div></div>
    </div>
  </div>

  <div class="card">
    <div class="stitle">Tools</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      <button class="btn2" onclick="fitToView()">⊞ Fit to View</button>
      <button class="btn2" onclick="resetShape()">↺ Reset Shape</button>
      <button class="btn2" onclick="clearAll()">⊘ Clear Canvas</button>
    </div>
    <div style="margin-top:10px;padding:8px;background:var(--bg);border-radius:6px;border:1px solid var(--bd);font-size:9.5px;color:var(--dim);line-height:1.6">
      <b style="color:var(--muted)">Tip:</b> Drag <span style="color:var(--gold)">●</span> corners to reshape.  Drag <span style="color:var(--teal)">◆</span> edge midpoints to push walls.  Click any zone to inspect.
    </div>
  </div>

</aside>

<!-- ═══ CANVAS ═══ -->
<main id="carea">
  <div id="tbar">
    <button class="tbtn act" id="t-sel" onclick="setTool('sel')">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 3 7 17 2.5-7.4 7.4-2.5L3 3z"/></svg>Select
    </button>
    <button class="tbtn" id="t-pan" onclick="setTool('pan')">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0m0 6V2a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0v10"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg>Pan
    </button>
    <div style="width:1px;background:var(--bd);margin:2px 3px"></div>
    <button class="tbtn" onclick="zoomBy(1.25)">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>+
    </button>
    <button class="tbtn" onclick="zoomBy(0.8)">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>−
    </button>
    <button class="tbtn" onclick="fitToView()">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>Fit
    </button>
    <div style="width:1px;background:var(--bd);margin:2px 3px"></div>
    <button class="tbtn" id="t-snap" onclick="toggleSnap()">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg>Snap
    </button>
    <div style="width:1px;background:var(--bd);margin:2px 3px"></div>
    <button class="tbtn" id="t-rot" onclick="setTool('rot')" title="Rotate Vaastu Layers — drag around centroid">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6"/><path d="M2.5 12a10 10 0 1 1 .5 5"/></svg>Rotate
    </button>
    <div style="display:flex;align-items:center;gap:5px;padding:0 4px;border-left:1px solid var(--bd);margin-left:2px">
      <span style="font-size:9px;color:var(--muted)">Vaastu</span>
      <span id="rotReadout" style="font-size:11px;font-weight:700;color:var(--gold);min-width:36px;text-align:right;font-variant-numeric:tabular-nums">0°</span>
      <button class="tbtn" onclick="resetVaastuRot()" title="Reset rotation to 0°" style="padding:2px 5px;font-size:9px">↺</button>
    </div>
  </div>
  <canvas id="cv"></canvas>
  <div id="scaleInfo">Scale: 11 px = 1 ft</div>
  <div id="coordInfo">— ft, — ft</div>
</main>

<!-- ═══ RIGHT PANEL ═══ -->
<aside class="rpanel">
  <div id="rphdr">
    <h3>Vaastu Zone Inspector</h3>
    <p>CLICK A ZONE TO EXPLORE</p>
  </div>
  <div id="zmsg">
    <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
      <circle cx="36" cy="36" r="34" stroke="#2a3650" stroke-width="1.2"/>
      <circle cx="36" cy="36" r="5" fill="#d4a843" opacity=".5"/>
      <polygon points="36,3 39,18 36,14 33,18" fill="#d4a843"/>
      <polygon points="36,69 39,54 36,58 33,54" fill="#4a5568"/>
      <line x1="36" y1="3" x2="36" y2="69" stroke="#2a3650" stroke-width=".6"/>
      <line x1="3" y1="36" x2="69" y2="36" stroke="#2a3650" stroke-width=".6"/>
      <line x1="10" y1="10" x2="62" y2="62" stroke="#2a3650" stroke-width=".4" stroke-dasharray="3,3"/>
      <line x1="62" y1="10" x2="10" y2="62" stroke="#2a3650" stroke-width=".4" stroke-dasharray="3,3"/>
      <text x="36" y="10.5" text-anchor="middle" fill="#d4a843" font-size="7" font-family="Inter" font-weight="600">N</text>
      <text x="36" y="67" text-anchor="middle" fill="#4a5568" font-size="7" font-family="Inter">S</text>
      <text x="67" y="39" text-anchor="middle" fill="#4a5568" font-size="7" font-family="Inter">E</text>
      <text x="5" y="39" text-anchor="middle" fill="#4a5568" font-size="7" font-family="Inter">W</text>
    </svg>
    <p>Enable a Vaastu layer then click inside any coloured zone on the floor plan to see its full analysis</p>
  </div>
  <div id="zcard"></div>
</aside>

</div><!-- #body -->

<!-- ═══ COMPASS RULER BAR ═══ -->
<div id="compassWrap">
  <div id="compassLabel">◈ VAASTU COMPASS  0° → 360°</div>
  <div id="compassAngle">— °  |  —</div>
  <canvas id="compassBar"></canvas>
</div>

</div><!-- #app -->

