function buildShapeGrid(){
  const grid = document.getElementById('sgrid');
  grid.innerHTML = '';
  Object.entries(SHAPES).forEach(([id,sh])=>{
    const btn = document.createElement('button');
    btn.className = 'sbtn' + (id===S.shapeId?' act':'');
    btn.id = 'sb-'+id;
    // mini preview canvas
    const ic = document.createElement('canvas');
    ic.width=28; ic.height=28;
    const gc = ic.getContext('2d');
    gc.strokeStyle = id===S.shapeId ? '#d4a843' : '#4a5568';
    gc.lineWidth = 1.4;
    drawShapeIcon(gc, id, 28, 28);
    btn.appendChild(ic);
    btn.appendChild(document.createTextNode(sh.label));
    btn.onclick = ()=>{ selectShape(id); };
    grid.appendChild(btn);
  });
}

function drawShapeIcon(gc, id, W, H){
  const p=2;
  const def = SHAPES[id];
  const vs = def.verts(W-p*2, H-p*2).map(v=>({x:v.x+p,y:v.y+p}));
  gc.beginPath();
  vs.forEach((v,i)=> i===0?gc.moveTo(v.x,v.y):gc.lineTo(v.x,v.y));
  gc.closePath();
  if(def.hole){
    const hs = def.hole(W-p*2,H-p*2).map(v=>({x:v.x+p,y:v.y+p}));
    gc.moveTo(hs[0].x,hs[0].y);
    hs.forEach((v,i)=>{ if(i>0)gc.lineTo(v.x,v.y); });
    gc.closePath();
  }
  gc.stroke();
}

function selectShape(id){
  S.shapeId = id;
  document.querySelectorAll('.sbtn').forEach(b=>b.classList.remove('act'));
  const btn = document.getElementById('sb-'+id);
  if(btn) btn.classList.add('act');
  // re-draw icon in gold
  const ic = btn.querySelector('canvas');
  if(ic){
    const gc = ic.getContext('2d'); gc.clearRect(0,0,28,28);
    gc.strokeStyle='#d4a843'; gc.lineWidth=1.4;
    drawShapeIcon(gc,id,28,28);
  }
  buildShape();
}

