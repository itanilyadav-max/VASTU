// ═══════════════════════════════════════════════════════
// COMPASS BAR — 0–360° Vaastu ruler with live needle
// ═══════════════════════════════════════════════════════
const cbEl  = document.getElementById('compassBar');
const cbCtx = cbEl.getContext('2d');

function resizeCompassBar(){
  const wrap = document.getElementById('compassWrap');
  cbEl.width  = wrap.clientWidth;
  cbEl.height = wrap.clientHeight;
  drawCompassBar();
}
window.addEventListener('resize', resizeCompassBar);

// Clicking the compass bar sets the "inspected" angle directly
cbEl.addEventListener('mousemove', e=>{
  const r=cbEl.getBoundingClientRect();
  const mx=e.clientX-r.left;
  const ang=(mx/cbEl.width)*360;
  S.compassAngle=Math.max(0,Math.min(359.9,ang));
  S.compassX=mx;
  let zoneName='—';
  for(let i=0;i<Z16.length;i++){
    const za=Z16[i][3]; let s=za-11.25,e2=za+11.25;
    if(s<0)s+=360; if(e2>=360)e2-=360;
    let hit=s>e2?(ang>=s||ang<e2):(ang>=s&&ang<e2);
    if(hit){zoneName=Z16[i][1]+' · '+Z16[i][4];break;}
  }
  document.getElementById('compassAngle').textContent=
    `${ang.toFixed(1)}°  |  ${zoneName}`;
  cbEl.style.cursor='crosshair';
});
cbEl.addEventListener('mouseleave', ()=>{
  // keep last angle shown but don't reset
  cbEl.style.cursor='default';
});

function drawCompassBar(){
  const W=cbEl.width, H=cbEl.height;
  if(W<10||H<10) return;
  cbCtx.clearRect(0,0,W,H);

  const trackTop=20, trackH=H-trackTop-4;

  // ── 1. Zone colour segments ──
  Z16.forEach((z,i)=>{
    const startDeg = z[3]-11.25;
    const endDeg   = z[3]+11.25;
    // handle wrap-around (ENE crosses 0°)
    const draw=(s,e)=>{
      const x1=(s/360)*W, x2=(e/360)*W;
      cbCtx.fillStyle=z[7].replace(/[\d.]+\)$/,'0.72)');
      cbCtx.fillRect(x1, trackTop, x2-x1, trackH);
      // zone border line
      cbCtx.strokeStyle=z[8]+'88';
      cbCtx.lineWidth=1;
      cbCtx.beginPath(); cbCtx.moveTo(x1,trackTop); cbCtx.lineTo(x1,trackTop+trackH); cbCtx.stroke();
    };
    if(startDeg<0){
      draw(startDeg+360, 360);
      draw(0, endDeg);
    } else if(endDeg>360){
      draw(startDeg, 360);
      draw(0, endDeg-360);
    } else {
      draw(startDeg, endDeg);
    }
  });

  // ── 2. Highlight hovered/selected zone on bar ──
  const activeZone = S.compassAngle>=0 ? (()=>{
    let found=-1;
    for(let i=0;i<Z16.length;i++){
      const za=Z16[i][3]; let s=za-11.25,e2=za+11.25;
      if(s<0)s+=360; if(e2>=360)e2-=360;
      let hit=s>e2?(S.compassAngle>=s||S.compassAngle<e2):(S.compassAngle>=s&&S.compassAngle<e2);
      if(hit){found=i;break;}
    }
    return found;
  })() : S.selZone;

  if(activeZone>=0){
    const z=Z16[activeZone];
    let s=z[3]-11.25, e2=z[3]+11.25;
    const drawHL=(s2,e2)=>{
      cbCtx.fillStyle=z[8]+'30';
      cbCtx.fillRect((s2/360)*W, trackTop, ((e2-s2)/360)*W, trackH);
      // top accent bar
      cbCtx.fillStyle=z[8];
      cbCtx.fillRect((s2/360)*W, trackTop, ((e2-s2)/360)*W, 2.5);
    };
    if(s<0){ drawHL(s+360,360); drawHL(0,e2); }
    else if(e2>360){ drawHL(s,360); drawHL(0,e2-360); }
    else drawHL(s,e2);
  }

  // ── 3. Tick marks & degree numbers ──
  // Every 22.5° = zone boundary
  for(let d=0;d<=360;d+=22.5){
    const xp=(d/360)*W;
    cbCtx.strokeStyle='rgba(212,168,67,0.45)';
    cbCtx.lineWidth=1;
    cbCtx.beginPath(); cbCtx.moveTo(xp, trackTop-1); cbCtx.lineTo(xp, trackTop+trackH); cbCtx.stroke();
  }
  // Every 45° = major tick with label
  for(let d=0;d<=360;d+=45){
    const xp=(d/360)*W;
    cbCtx.strokeStyle='rgba(212,168,67,0.7)';
    cbCtx.lineWidth=1.5;
    cbCtx.beginPath(); cbCtx.moveTo(xp, trackTop-3); cbCtx.lineTo(xp, trackTop+trackH); cbCtx.stroke();
    // degree number
    cbCtx.fillStyle='rgba(212,168,67,0.8)';
    cbCtx.font='bold 8px Inter';
    cbCtx.textAlign='center'; cbCtx.textBaseline='bottom';
    cbCtx.fillText(d+'°', xp, trackTop-1);
  }

  // ── 4. Devta / direction labels inside each segment ──
  Z16.forEach(z=>{
    const xp=(z[3]/360)*W;
    const segW=(22.5/360)*W;
    if(segW<30) return; // too narrow to label

    // abbreviated label: direction short
    cbCtx.save();
    cbCtx.font=`bold ${Math.min(10,segW*0.28)}px Inter`;
    cbCtx.fillStyle=z[8];
    cbCtx.textAlign='center'; cbCtx.textBaseline='middle';
    cbCtx.globalAlpha=0.92;
    cbCtx.fillText(z[2], xp, trackTop + trackH*0.32);
    cbCtx.font=`${Math.min(8,segW*0.22)}px Inter`;
    cbCtx.fillStyle='rgba(230,220,210,0.75)';
    cbCtx.fillText(z[4], xp, trackTop + trackH*0.65);
    cbCtx.restore();
  });

  // ── 5. North marker at 270° (canvas math North) ──
  {
    const xN=(270/360)*W;
    cbCtx.save();
    cbCtx.fillStyle='#d4a843';
    cbCtx.font='bold 9px Inter';
    cbCtx.textAlign='center'; cbCtx.textBaseline='bottom';
    cbCtx.fillText('▲N', xN, trackTop-1);
    cbCtx.restore();
  }

  // ── 6. Cardinal markers at top ──
  const cardinals=[{d:0,l:'E'},{d:90,l:'S'},{d:180,l:'W'},{d:270,l:'N'},{d:360,l:'E'}];
  cardinals.forEach(c=>{
    if(c.d===0||c.d===360) return; // already labeled as degree
    const xp=(c.d/360)*W;
    cbCtx.fillStyle='rgba(180,200,220,0.6)';
    cbCtx.font='bold 8px Inter';
    cbCtx.textAlign='center'; cbCtx.textBaseline='bottom';
    cbCtx.fillText(c.l, xp, trackTop-1);
  });

  // ── 7. Live needle ──
  if(S.compassX>=0 && S.compassAngle>=0){
    const nx = S.compassX;
    // needle line
    cbCtx.save();
    cbCtx.strokeStyle='#ffffff';
    cbCtx.lineWidth=1.5;
    cbCtx.shadowColor='#ffffff';
    cbCtx.shadowBlur=6;
    cbCtx.beginPath(); cbCtx.moveTo(nx, trackTop-4); cbCtx.lineTo(nx, trackTop+trackH+2); cbCtx.stroke();
    cbCtx.shadowBlur=0;
    // triangle pointer at top
    cbCtx.fillStyle='#ffffff';
    cbCtx.beginPath(); cbCtx.moveTo(nx,trackTop+2); cbCtx.lineTo(nx-5,trackTop-6); cbCtx.lineTo(nx+5,trackTop-6); cbCtx.closePath(); cbCtx.fill();
    // angle pill below needle
    const label=S.compassAngle.toFixed(1)+'°';
    cbCtx.font='bold 9px Inter';
    cbCtx.textAlign='center'; cbCtx.textBaseline='top';
    const tw=cbCtx.measureText(label).width+10;
    let px2=Math.max(tw/2+2, Math.min(W-tw/2-2, nx));
    cbCtx.fillStyle='rgba(9,14,22,0.92)';
    cbCtx.strokeStyle='rgba(255,255,255,0.4)';
    cbCtx.lineWidth=1;
    cbCtx.beginPath(); cbCtx.roundRect(px2-tw/2, trackTop+trackH+3, tw, 14, 4); cbCtx.fill(); cbCtx.stroke();
    cbCtx.fillStyle='#ffffff';
    cbCtx.fillText(label, px2, trackTop+trackH+5);
    cbCtx.restore();
  }

  // ── 8. Outer border ──
  cbCtx.strokeStyle=`rgba(42,54,80,0.8)`;
  cbCtx.lineWidth=1;
  cbCtx.strokeRect(0,trackTop,W,trackH);
}

// Hook compass redraw into RAF loop
const _origRender = render;

// ═══════════════════════════════════════════════════════
// BOOT
// ═══════════════════════════════════════════════════════
buildShapeGrid();
buildShape();
setTool('sel');
resizeCompassBar();
render();
</script>
