function applyDims(){
  S.Lft   = Math.max(8, parseFloat(document.getElementById('inL').value)||40);
  S.Bft   = Math.max(8, parseFloat(document.getElementById('inB').value)||30);
  S.scale = Math.max(4, Math.min(30, parseFloat(document.getElementById('inScale').value)||11));
  document.getElementById('scaleInfo').textContent = `Scale: ${S.scale} px = 1 ft`;
  buildShape();
}

function buildShape(){
  const W = S.Lft * S.scale;
  const H = S.Bft * S.scale;
  const def = SHAPES[S.shapeId];
  const raw = def.verts(W, H);
  const cx0 = cv.width/2 - W/2;
  const cy0 = cv.height/2 - H/2;
  S.verts = raw.map(v=>({x: v.x+cx0, y: v.y+cy0}));
  if(def.hole){
    const hr = def.hole(W,H);
    S.holeVerts = hr.map(v=>({x: v.x+cx0, y: v.y+cy0}));
  } else {
    S.holeVerts = [];
  }
  S.selZone = -1;
  updateZoneCard(-1);
}

function resetShape(){ buildShape(); }
function clearAll(){ S.verts=[]; S.holeVerts=[]; S.selZone=-1; updateZoneCard(-1); }

// ═══════════════════════════════════════════════════════
// MATH HELPERS
// ═══════════════════════════════════════════════════════
function centroid(vs){
  let A=0,cx=0,cy=0,n=vs.length;
  for(let i=0;i<n;i++){
    const j=(i+1)%n;
    const c = vs[i].x*vs[j].y - vs[j].x*vs[i].y;
    A+=c; cx+=(vs[i].x+vs[j].x)*c; cy+=(vs[i].y+vs[j].y)*c;
  }
  A/=2; cx/=6*A; cy/=6*A;
  return {x:cx, y:cy, area:Math.abs(A)};
}

function bbox(vs){
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  vs.forEach(v=>{ x0=Math.min(x0,v.x);y0=Math.min(y0,v.y);x1=Math.max(x1,v.x);y1=Math.max(y1,v.y); });
  return {x0,y0,x1,y1,w:x1-x0,h:y1-y0};
}

function pip(px,py,vs){ // point in polygon
  let inside=false;
  for(let i=0,j=vs.length-1;i<vs.length;j=i++){
    const xi=vs[i].x,yi=vs[i].y,xj=vs[j].x,yj=vs[j].y;
    if(((yi>py)!==(yj>py))&&(px<(xj-xi)*(py-yi)/(yj-yi)+xi)) inside=!inside;
  }
  return inside;
}

function dst(ax,ay,bx,by){ return Math.sqrt((ax-bx)**2+(ay-by)**2); }

function edgeMid(vs){
  return vs.map((v,i)=>{
    const j=(i+1)%vs.length;
    return {x:(v.x+vs[j].x)/2, y:(v.y+vs[j].y)/2, i, j};
  });
}

// ═══════════════════════════════════════════════════════
// ZONE HIT
// canvas: East=0°, angles increase clockwise
// ═══════════════════════════════════════════════════════
function zoneAt(px,py,cen){
  if(!pip(px,py,S.verts)) return -1;
  let ang = Math.atan2(py-cen.y, px-cen.x)*180/Math.PI;
  if(ang<0) ang+=360;
  // subtract rotation so we test against the rotated zone positions
  ang = ((ang - S.vaastuRot) % 360 + 360) % 360;
  for(let i=0;i<Z16.length;i++){
    const za = Z16[i][3];
    let s=za-11.25, e=za+11.25;
    if(s<0)s+=360; if(e>=360)e-=360;
    if(s>e){ if(ang>=s||ang<e) return i; }
    else    { if(ang>=s&&ang<e) return i; }
  }
  return -1;
}

